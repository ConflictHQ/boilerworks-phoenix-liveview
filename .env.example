# Development defaults. Never use in production.
#
# All variables read by the app (app/config/runtime.exs and
# app/lib/boilerworks/features.ex). docker/docker-compose.yml sets these
# directly on the app service; this file documents them for other setups.

# Phoenix
PHX_SERVER=true
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=dev-only-secret-key-base-that-is-at-least-64-bytes-long-for-phoenix-sessions-ok

# Database
DATABASE_URL=ecto://boilerworks:boilerworks@localhost:5432/boilerworks_dev
POOL_SIZE=10

# Feature toggles (must be the string "true" to enable)
FEATURE_FORMS=true
FEATURE_WORKFLOWS=true
